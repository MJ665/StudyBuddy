# =============================================================================
#  StudyHub monorepo — .gitignore
#  Turborepo · npm workspaces · Next.js (web) · FastAPI/Python (api) · Expo (mobile)
# =============================================================================

# ── Dependencies ─────────────────────────────────────────────────────────────
node_modules/
.pnp
.pnp.*

# ── Env & secrets ────────────────────────────────────────────────────────────
# Ignore ALL env files (they hold secrets), EXCEPT the safe root template.
.env
.env.*
!/.env.example
# Real credential files (their *.example placeholders stay tracked)
apps/mobile/google-services.json
apps/mobile/play-service-account.json
.sentryclirc
.env.sentry-build-plugin

# ── Turborepo ────────────────────────────────────────────────────────────────
.turbo/

# ── Next.js (apps/web-next) ──────────────────────────────────────────────────
.next/
out/
next-env.d.ts
*.tsbuildinfo
.vercel/

# ── Node build output & caches ───────────────────────────────────────────────
dist/
build/
coverage/
*.tgz
.eslintcache

# ── Expo / React Native (apps/mobile) ────────────────────────────────────────
.expo/
web-build/
apps/mobile/android/
apps/mobile/ios/
*.apk
*.aab
*.ipa
*.keystore
!debug.keystore

# ── Python (apps/api) ────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ── Generated / local caches (regenerable) ───────────────────────────────────
# graphify-out is the local knowledge graph — regenerate with `graphify update .`
graphify-out/
_archive/

# ── Logs ─────────────────────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── Editors / OS ─────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.swp
.gstack/

# ── Scratch / temporary ──────────────────────────────────────────────────────
temp*
tempPlan.md
tempProcess.md

# ── Google Play Store release kit (local-only: listing drafts, assets, secrets) ──
google-playstore/

# MediaPipe WASM is large + regenerated from node_modules on predev/prebuild
apps/web-next/public/mediapipe/wasm/

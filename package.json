{
  "name": "studyhub-monorepo",
  "private": true,
  "packageManager": "npm@11.8.0",
  "engines": {
    "node": ">=18"
  },
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "dev:next": "turbo dev --filter=web-next",
    "dev:api": "turbo dev --filter=api",
    "lint": "turbo lint",
    "test": "turbo test"
  },
  "devDependencies": {
    "turbo": "^2.0.0"
  }
}
